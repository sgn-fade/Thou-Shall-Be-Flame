  m_Name: 
  m_EditorClassIdentifier: PaleFernStudio.Looksmith.Demo::PaleFernStudio.Looksmith.Demo.DemoShowcase
  looks:
  - name: Stylized Realism
    description: Hero shooters, open world. PBR with a soft ramp blend, palette-tinted
      ambient, a clean filmic grade.
    profile: {fileID: 11400000, guid: bb61eda797294a149935658e9b3350a7, type: 2}
    mood: {fileID: 11400000, guid: d5f467a17736c5b45bc57e6efd8e0d92, type: 2}
  - name: Stylized Realism (Poster)
    description: 'Flat poster colour: the light in a few clean steps, inked edges
      and a touch of paper, like a printed travel poster.'
    profile: {fileID: 11400000, guid: 71f00cf6efed4c746ac715e40367e76b, type: 2}
    mood: {fileID: 11400000, guid: d5f467a17736c5b45bc57e6efd8e0d92, type: 2}
  - name: Cel Anime
    description: Action RPG, JRPG, anime. Hard two-tone light with cool shadows,
      crisp line art, rim light, specular streaks.
    profile: {fileID: 11400000, guid: 32322acbb32a17441ba9d4567c805394, type: 2}
    mood: {fileID: 11400000, guid: 6b7e614a9792c004383ae160cdca42b6, type: 2}
  - name: Cel Anime (Paper)
    description: 'A printed illustration: the paper''s grain on every surface, moving
      with the world as you walk.'
    profile: {fileID: 11400000, guid: 04229b16cf117644abb06313e2a76f83, type: 2}
    mood: {fileID: 11400000, guid: 6b7e614a9792c004383ae160cdca42b6, type: 2}
  - name: Silent Fog
    description: Survival horror, foggy towns, eerie walks. Fog that swallows everything
      past a few metres, grain, a dark vignette.
    profile: {fileID: 11400000, guid: 120b6c7717a1d874ebc595eb64f21bcb, type: 2}
    mood: {fileID: 11400000, guid: 6b7e614a9792c004383ae160cdca42b6, type: 2}
  skies:
  - {fileID: 11400000, guid: 6b7e614a9792c004383ae160cdca42b6, type: 2}
  - {fileID: 11400000, guid: d5f467a17736c5b45bc57e6efd8e0d92, type: 2}
